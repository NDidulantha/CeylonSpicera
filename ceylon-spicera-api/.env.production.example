# Your free DuckDNS hostname pointing at the VM's public IP, e.g. ceylonspicera.duckdns.org
API_DOMAIN=YOUR_SUBDOMAIN.duckdns.org

APP_NAME="Ceylon Spicera"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:fjgYRTyW71VfYmgFEpgtdlOlixtShMxSHVoSlPJpBV8=
APP_TIMEZONE=Asia/Colombo
APP_URL=https://YOUR_SUBDOMAIN.duckdns.org

# Internal Docker Compose network — "db" is the Postgres service name, not localhost.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ceylon_spicera
DB_USERNAME=ceylon
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Your Vercel production URL.
FRONTEND_URL=https://ceylon-spicera.vercel.app
SANCTUM_STATEFUL_DOMAINS=ceylon-spicera.vercel.app

MAIL_MAILER=log

PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=https://YOUR_SUBDOMAIN.duckdns.org/api/payments/payhere/notify

PRICING_USD_TO_LKR_RATE=300
FX_BASE=USD
