# The backend's own public hostname (Caddy issues HTTPS for exactly this domain).
API_DOMAIN=api.ceylonspicera.com

APP_NAME="Ceylon Spicera"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:fjgYRTyW71VfYmgFEpgtdlOlixtShMxSHVoSlPJpBV8=
APP_TIMEZONE=Asia/Colombo
APP_URL=https://api.ceylonspicera.com

# Internal Docker Compose network — "db" is the Postgres service name, not localhost.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ceylon_spicera
DB_USERNAME=ceylon
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# The storefront's own domain — must be the EXACT origin the browser sends
# (CORS and Sanctum's stateful-domain check both require an exact match,
# not a wildcard subdomain match). Vercel serves from www, not the bare
# apex, so this has to say www here even though the apex also resolves.
# SESSION_DOMAIN's leading dot is what actually shares the cookie across
# both ceylonspicera.com and api.ceylonspicera.com — that part does cover
# every subdomain, unlike the two lines above it.
FRONTEND_URL=https://www.ceylonspicera.com
SANCTUM_STATEFUL_DOMAINS=www.ceylonspicera.com
SESSION_DOMAIN=.ceylonspicera.com
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log

PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=https://api.ceylonspicera.com/api/payments/payhere/notify

PRICING_USD_TO_LKR_RATE=300
FX_BASE=USD
