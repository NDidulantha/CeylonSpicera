# The backend's own public hostname (Caddy issues HTTPS for exactly this domain).
API_DOMAIN=api.ceylonspicera.com

APP_NAME="Ceylon Spicera"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:fjgYRTyW71VfYmgFEpgtdlOlixtShMxSHVoSlPJpBV8=
APP_TIMEZONE=Asia/Colombo
APP_URL=https://api.ceylonspicera.com

# Internal Docker Compose network — "db" is the Postgres service name, not localhost.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ceylon_spicera
DB_USERNAME=ceylon
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# The storefront's own domain. Since both sides now share the same root
# domain (ceylonspicera.com), SESSION_DOMAIN with a leading dot lets the
# login cookie be read by both — this is what makes login/cart/checkout
# actually work across the two subdomains. Without a shared root domain,
# none of this works no matter how these three are set.
FRONTEND_URL=https://ceylonspicera.com
SANCTUM_STATEFUL_DOMAINS=ceylonspicera.com
SESSION_DOMAIN=.ceylonspicera.com
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log

PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=https://api.ceylonspicera.com/api/payments/payhere/notify

PRICING_USD_TO_LKR_RATE=300
FX_BASE=USD
